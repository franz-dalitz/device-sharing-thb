{{ define "navbar" }}
<script>
    if (sessionStorage.getItem('userID') == null) {
        sessionStorage.setItem('userID', 0);
    }
</script>

<script src="/static/htmx/ext/ws.js"></script>
<script src="/static/bootstrap/js/bootstrap.bundle.min.js"></script>
<div hx-ext="ws" id="notify-connect"></div>
<div id="notifications" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
<script>
    document.getElementById('notify-connect').setAttribute('ws-connect', '/ws?userID=' + sessionStorage.getItem('userID'));

    document.body.addEventListener('htmx:wsAfterMessage', function (event) {
        const newToast = document.getElementById("notifications").firstElementChild;
        const realToast = new bootstrap.Toast(newToast);
        realToast.show();

        newToast.addEventListener('hidden.bs.toast', function () {
            newToast.remove();
        });
    });
</script>

<nav class="navbar navbar-expand-sm navbar-dark bg-danger fixed-bottom">
    <div class="justify-content-center text-center">

        <ul class="navbar-nav d-flex flex-row me-1 align-items-center flex-grow-1">
            <li class="nav-item">
                <a class="nav-link mx-1 text-black" href="/browse"><i class="bi bi-search"></i></a>
            </li>
            <li class="nav-item">
                <a class="nav-link mx-1 text-black" href="#"><i class="bi bi-wallet"></i></a>
            </li>
            <li class="nav-item">
                <a class="nav-link active mx-1 text-black" href="/adddevice"><i class="bi bi-plus-circle"></i></a>
            </li>
            <li class="nav-item">
                <a class="nav-link mx-1 text-black" href="/chatsoverview"><i class="bi bi-chat-left-dots"></i></a>
            </li>
            </li>
            <li class="nav-item">
                <a class="nav-link text-black" href="/settings"><i class="bi bi-gear-wide"></i></a>
            </li>
        </ul>
    </div>
</nav>
{{ end }}