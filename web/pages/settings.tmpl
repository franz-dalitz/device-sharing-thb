<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>My Account - Settings</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="/static/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <script src="/static/htmx/htmx.min.js"></script>
</head>

<body class="bg-light">

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6">

        <div class="card shadow-sm">
          <div class="card-body">

            <h3 class="mb-4 text-center">My Account</h3>

            <!-- Email -->
            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">Email</label>
              <input type="email" class="form-control" id="email" hx-get="/api/mail" hx-trigger="load"
                hx-vals="js:{userID: sessionStorage.getItem('userID')}">
            </div>

            <!-- Password (masked) -->
            <div class="mb-3">
              <label for="password" class="form-label fw-semibold">Password</label>
              <input type="password" class="form-control" id="password" value="****************">
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-between">
              <button class="btn btn-danger" hx-post="/logout" hx-swap="none">
                Logout
              </button>

              <div class="mb-3" hx-get="/api/useropts/" hx-swap="innterHtml" hx-trigger="load" hx-target="#username"
                hx-vals="js:{userID: sessionStorage.getItem('userID')}">
                <label for="username" class="form-label fw-semibold">Users</label>
                <select id="username" name="id" class="form-select" hx-post="/api/userselect" hx-trigger="change"
                  hx-swap="none" onchange="sessionStorage.setItem('userID', this.value)" required>
                </select>
              </div>

              <button class="btn btn-danger" hx-post="/update-account" hx-swap="none">
                Update
              </button>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  {{ template "navbar" }}

</body>

</html>