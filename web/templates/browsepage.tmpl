<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="/static/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <title>DeviceSharing@THB</title>
</head>
<body>
    <h1 class="text-center">DeviceSharing@THB</h1>
    <p class="text-center">{{ .dynamic }}</p>

    <script src="/static/htmx/htmx.min.js"></script>
    <script src="/static/bootstrap/js/bootstrap.bundle.min.js"></script>


  

  <!-- Main Content -->
  <div class="container py-4">
    <!-- Search -->
    <div class="row mb-4">
      <div class="col-12">
        <input type="text"
               class="form-control"
               placeholder="Search"
               name="search"
               hx-get="/search"
               hx-trigger="keyup changed delay:300ms"
               hx-target="#device-list"
               hx-indicator="#loading-indicator" />
        <div id="loading-indicator" class="mt-1 text-muted" style="display: none;">Loading...</div>
      </div>
    </div>

    <!-- Device List -->
    <div id="device-list" class="row g-4">

      <!-- Example Device Card -->
      <div class="col-md-6 col-lg-4" >
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">3D Printer - Prusa i3</h5>
            <p class="card-text">Suitable for student projects and prototypes.</p>
            <p class="mb-1 text-muted">Category: Electronics</p>
            <p class="mb-1 text-muted">Location: THB Building B, Room 21</p>
            <a href="/device/1" class="btn btn-sm btn-primary">View Details...</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg bg-light" class="navbar sticky-bottom bg-light" >
  <div class="container-fluid" style="width: 300px; margin: 0 auto;" >
    {{/* <a class="navbar-brand" href="#">Navbar</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button> */}}
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link active" aria-current="page" href="#">Suche</a>
        <a class="nav-link" href="#">Angebote</a>
        <a class="nav-link" href="#">Chats</a>
        <a class="nav-link disabled">Settings</a>
      </div>
    </div>
  </div>
</nav>

  <!-- HTMX Loading Handling -->
  <script>
    document.body.addEventListener('htmx:indicatorStart', function(evt) {
      document.getElementById('loading-indicator').style.display = 'block';
    });
    document.body.addEventListener('htmx:indicatorStop', function(evt) {
      document.getElementById('loading-indicator').style.display = 'none';
    });
  </script>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
