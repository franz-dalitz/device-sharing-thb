{
    "swagger": "2.0",
    "info": {
        "title": "Swagger Example API",
        "contact": {},
        "license": {
            "name": "Apache 2.0"
        },
        "version": "1.0"
    },
    "paths": {
        "/api/devices": {
            "get": {
                "description": "update an existing device",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "owner id",
                        "name": "owner",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "device id",
                        "name": "ID",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "device title",
                        "name": "Title",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "device category",
                        "name": "Category",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "device description",
                        "name": "Description",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "device location",
                        "name": "Location",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    }
}